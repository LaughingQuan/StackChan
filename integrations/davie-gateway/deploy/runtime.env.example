STACKCHAN_DAVIE_PUBLIC_HOST=stackchan-gateway.local
STACKCHAN_DAVIE_PORT=8793
STACKCHAN_MEDIA_BASE_URL=http://media-gateway.local:8790
STACKCHAN_DAVIE_BASE_URL=http://davie-gateway.local:8642

# Start conservatively; tune only with real microphone/speaker evidence.
STACKCHAN_ENDPOINT_SILENCE_MS=900
STACKCHAN_ENDPOINT_MIN_SPEECH_MS=240
STACKCHAN_ENDPOINT_MAX_TURN_MS=20000
STACKCHAN_ENDPOINT_MIN_RMS=420
STACKCHAN_BARGE_IN_CONFIRMATION_MS=360
STACKCHAN_MAX_TRANSCRIPT_WORDS_PER_SECOND=6

# End an inactive voice session so custom wake detection becomes available again.
STACKCHAN_SESSION_IDLE_TIMEOUT_SECONDS=120
STACKCHAN_SESSION_WATCHDOG_INTERVAL_SECONDS=1
STACKCHAN_RECENT_SESSION_LIMIT=20

# Reading progress is atomically persisted here and survives gateway/device restarts.
STACKCHAN_READER_STATE_PATH=/var/lib/stackchan-davie/readers.json
STACKCHAN_MAX_READER_CHARS=500000
