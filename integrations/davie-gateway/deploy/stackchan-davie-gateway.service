[Unit]
Description=StackChan Davie Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stackchan-davie
Group=stackchan-davie
WorkingDirectory=/opt/stackchan-davie-gateway
EnvironmentFile=-/etc/stackchan-davie/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=davie-api-key:/etc/stackchan-davie/davie-api-key
LoadCredential=device-token:/etc/stackchan-davie/device-token
LoadCredential=admin-token:/etc/stackchan-davie/admin-token
Environment=STACKCHAN_DAVIE_API_KEY_FILE=%d/davie-api-key
Environment=STACKCHAN_DEVICE_TOKEN_FILE=%d/device-token
Environment=STACKCHAN_ADMIN_TOKEN_FILE=%d/admin-token
ExecStart=/opt/stackchan-davie-gateway/.venv/bin/stackchan-davie-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=stackchan-davie
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
