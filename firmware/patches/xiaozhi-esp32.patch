+        return false;
+    }
+
+    const size_t write =
+        inference_write_index_.load(std::memory_order_relaxed);
+    const size_t next = (write + 1) % kInferenceQueueCapacity;
+    if (next == inference_read_index_.load(std::memory_order_acquire)) {
+        return false;
+    }
+
+    auto& frame = inference_ring_[write];
+    frame.generation = segment.generation;
+    frame.segment_id = segment.segment_id;
+    frame.sample_count = static_cast<uint16_t>(sample_count);
+    frame.flags = flags;
+    if (sample_count > 0 && samples != nullptr) {
+        std::memcpy(
+            frame.samples,
+            samples,
+            sample_count * sizeof(int16_t));
+    }
+    inference_write_index_.store(next, std::memory_order_release);
+    if (multinet_inference_task_ != nullptr) {
+        xTaskNotifyGive(multinet_inference_task_);
+    }
+    return true;
