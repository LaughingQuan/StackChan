# Copy this file to sdkconfig.defaults.local and replace the gateway host.
# Wi-Fi credentials do not belong here; provision them through the device UI.
CONFIG_OTA_URL="http://stackchan-gateway.local:8793/xiaozhi/ota/"
CONFIG_STACKCHAN_DAVIE_LOCAL_RUNTIME=y
CONFIG_STACKCHAN_DAVIE_LOW_LATENCY_WIFI=y

# Use one English MultiNet command. Similar aliases compete with each other and
# reduce recognition confidence, so keep the canonical spoken phrase unique.
CONFIG_USE_CUSTOM_WAKE_WORD=y
CONFIG_CUSTOM_WAKE_WORD="DAVIE"
CONFIG_CUSTOM_WAKE_WORD_DISPLAY="Davie"
CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=8
CONFIG_SR_MN_EN_MULTINET5_SINGLE_RECOGNITION_QUANT8=y
CONFIG_SEND_WAKE_WORD_DATA=n
CONFIG_WAKE_WORD_DETECTION_IN_LISTENING=y

# StackChan exposes a two-channel input with a speaker reference channel. This
# enables the upstream AFE AEC path; acoustic performance still needs physical
# validation for each enclosure and speaker volume.
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=y
